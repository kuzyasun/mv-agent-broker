{
  "name": "@gemslibe/agent-broker",
  "version": "0.3.0",
  "description": "Local deterministic execution/session layer with MCP interface for multi-vendor coding agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "agent-broker": "bin/agent-broker.js"
  },
  "files": [
    "bin",
    "dist",
    "docs/providers.md",
    "docs/operator-guide.md",
    "docs/coordinator-instructions.md",
    "docs/git-review-plan.md",
    "docs/examples",
    "scripts/start-ui.ps1",
    "runtime-manifest.json"
  ],
  "scripts": {
    "broker": "node --experimental-transform-types src/operator/main.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build:ui && npm run build && node scripts/generate-runtime-manifest.mjs",
    "release:pack": "npm run typecheck && node scripts/pack-broker.mjs"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.3",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "preact": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
